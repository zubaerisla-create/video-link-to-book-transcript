{
  "manifest_version": 3,
  "name": "Transcriptly — Free YouTube Transcript Importer",
  "version": "1.0.0",
  "description": "Import clean transcripts from YouTube into Transcriptly without datacenter IP rate limits.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Transcriptly Importer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://habd.tech/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ]
}
